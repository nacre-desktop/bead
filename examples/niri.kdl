// Nested development only. Never install as the session configuration.
spawn-at-startup "sh" "-c" "exec nacre-shell --namespace bead-dev --ui ui/main.json >> \"${BEAD_PREVIEW_LOG:-/dev/null}\" 2>&1"
hotkey-overlay { skip-at-startup; }
animations { off; }
binds { Mod+Shift+E { quit; }; }

output "winit" { scale 1.5; }
