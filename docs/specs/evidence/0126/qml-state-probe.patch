+// PointerHandler grabs may leave mouseGrabberItem() empty. Cache the real
+// unique control at the press, then read its state only while left is held.
+static std::map<QQuickWindow*,QPointer<QQuickItem>> pressed_sliders;
+static void slidersAt(QQuickItem *item,const QPointF &point,std::vector<QQuickItem*> &found) {
+    if(!item->isVisible()||!item->isEnabled()) return;
+    const bool inside=item->contains(item->mapFromScene(point));
+    if(item->clip()&&!inside) return;
+    if(inside&&item->property("visualPosition").isValid()) found.push_back(item);
+    for(auto *child:item->childItems()) slidersAt(child,point,found);
+}
