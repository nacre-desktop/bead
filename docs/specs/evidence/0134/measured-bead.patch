+impl Drop for Predecoder {
+    fn drop(&mut self) {
+        {
+            let mut state = self.signal.lock();
+            state.stopping = true;
+            state.pending = None;
+            state.cached = None;
+            self.signal.changed.notify_all();
+        }
+        if let Some(worker) = self
+            .worker
+            .lock()
+            .unwrap_or_else(|poison| poison.into_inner())
+            .take()
+        {
+            let _ = worker.join();
+        }
+    }
+}
