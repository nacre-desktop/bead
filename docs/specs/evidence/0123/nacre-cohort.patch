+    /// Prepare current-setting palette markers for one bounded catalogue page.
+    pub fn prewarm_catalogue(
+        &self,
+        cli: &mut crate::palette_cli::Cli,
+        ids: &[String],
+    ) -> Result<Value> {
+        if ids.len() > PALETTE_PREWARM_COUNT {
+            return Err("Too many wallpapers requested for palette prewarming".into());
+        }
+        if ids.is_empty() {
+            return Ok(json!({"prepared":0,"computed":0}));
+        }
+        let catalogue = self.catalog_with_ids(Some(ids))?;
+        let scheme = state::read(&self.paths.state.join("scheme.json"), json!({}))?;
+        let settings = self.settings()?;
+        let automatic = json::truthy(&settings["paletteAutoMode"]);
+        let mut prepared = 0;
+        let mut computed = 0;
+        for item in catalogue["entries"]
+            .as_array()
+            .ok_or("Invalid wallpaper catalog")?
+        {
+            let (Some(source), Some(poster)) = (item["path"].as_str(), item["poster"].as_str())
+            else {
+                continue;
+            };
+            let poster_path = Path::new(poster);
+            if !poster_path.is_file() {
+                continue;
+            }
+            let mode = automatic
+                .then(|| Self::wallpaper_mode(poster_path))
+                .transpose()?;
+            let marker = self.palette_marker(
+                poster_path,
+                scheme["flavour"].as_str().unwrap_or("default"),
+                None,
+                Some(Path::new(source)),
+                mode,
+                None,
+            )?;
+            let data = if marker.is_file() {
+                state::read(&marker, json!({}))?
+            } else {
+                let mut words = vec![
+                    "wallpaper".into(),
+                    "-p".into(),
+                    poster.into(),
+                    "--source".into(),
+                    source.into(),
+                ];
+                if let Some(mode) = mode {
+                    words.extend(["--mode".into(), mode.into()]);
+                }
+                let data = self.query_palette(cli, words)?;
+                atomic(&marker, &data)?;
+                computed += 1;
+                data
+            };
+            if let Err(error) = self.prepare_thumbnail(item, &data) {
+                eprintln!("Wallpaper palette prewarm thumbnail: {error}");
+            }
+            prepared += 1;
+        }
+        trim_palette_cache(&self.cache(), PALETTE_CACHE_COUNT)?;
+        Ok(json!({"prepared":prepared,"computed":computed}))
+    }
