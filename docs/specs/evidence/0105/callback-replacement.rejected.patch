diff --git a/crates/bead-wayland/src/policy.rs b/crates/bead-wayland/src/policy.rs
index 3b8f061..a67624d 100644
--- a/crates/bead-wayland/src/policy.rs
+++ b/crates/bead-wayland/src/policy.rs
@@ -64,8 +64,27 @@ mod tests {
 pub(crate) struct Callbacks {
     pub pending: bool,
     epoch: u64,
+    content: Option<u64>,
+    replaced: bool,
 }
 impl Callbacks {
+    /// One newly accepted scene may replace an outstanding submission. Animation
+    /// ticks still wait for the callback; a second update coalesces until then.
+    /// Presentation feedback is required so the old callback cannot acknowledge
+    /// newer content through the callback-only persistence fallback.
+    pub fn can_draw(&self, content: u64, presentation: bool) -> bool {
+        !self.pending || (presentation && !self.replaced && self.content != Some(content))
+    }
+    pub fn request_content(&mut self, content: u64) -> Option<u64> {
+        self.content = Some(content);
+        if self.pending {
+            self.replaced = true;
+            None
+        } else {
+            self.replaced = false;
+            Some(self.request())
+        }
+    }
     pub fn request(&mut self) -> u64 {
         self.epoch = self.epoch.wrapping_add(1);
         self.pending = true;
@@ -98,4 +117,23 @@ mod callback_tests {
         assert!(c.accept(current));
         assert!(!c.accept(current));
     }
+    #[test]
+    fn fresh_content_can_replace_once_without_another_callback() {
+        let mut c = Callbacks::default();
+        assert!(c.can_draw(1, true));
+        let first = c.request_content(1).unwrap();
+        assert!(!c.can_draw(1, true));
+        assert!(!c.can_draw(2, false));
+        assert!(c.can_draw(2, true));
+        assert_eq!(c.request_content(2), None);
+        assert!(!c.can_draw(3, true));
+        assert!(c.accept(first));
+        assert!(c.can_draw(3, true));
+        let next = c.request_content(3).unwrap();
+        assert_ne!(next, first);
+        assert!(c.can_draw(4, true));
+        c.invalidate();
+        assert!(!c.accept(next));
+        assert!(c.can_draw(4, false));
+    }
 }
