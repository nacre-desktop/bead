@@ -1541,0 +1567,49 @@ mod tests {
+    #[test]
+    fn private_font_scope_survives_idle_trim_and_dies_with_tree_cache() {
+        let scope = crate::FontSystemScope::Private;
+        let mut cache = TreeCache::with_font_system_scope(scope);
+        let font = std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("../bead-test/fonts/IBMPlexSans.ttf");
+        let mut text_scene = scene();
+        text_scene.font_files = vec![font];
+        text_scene.primitives = vec![Primitive::Text {
+            rect: Rect::new(0., 0., 8., 8.),
+            text: "A".into(),
+            family: "IBM Plex Sans".into(),
+            size: 8.,
+            color: [20, 30, 40, 255],
+            weight: 400,
+            align: None,
+        }];
+        cache.prepare(&text_scene, 1.).unwrap();
+        assert_eq!(cache.raster.font_system_scope, scope);
+        let live = std::sync::Arc::downgrade(cache.raster.fonts.as_ref().unwrap());
+
+        cache.trim_idle();
+        assert_eq!(cache.raster.font_system_scope, scope);
+        assert!(
+            live.upgrade().is_some(),
+            "idle trim keeps same-view shaping warm"
+        );
+
+        // Changing the font set replaces the raster helper but keeps its owner
+        // policy, and releases the obsolete private FontSystem.
+        cache.font_files.clear();
+        if let Primitive::Text { text, .. } = &mut text_scene.primitives[0] {
+            *text = "B".into();
+        }
+        cache.prepare(&text_scene, 1.).unwrap();
+        assert_eq!(cache.raster.font_system_scope, scope);
+        assert!(
+            live.upgrade().is_none(),
+            "old private font set was replaced"
+        );
+        let rebuilt = std::sync::Arc::downgrade(cache.raster.fonts.as_ref().unwrap());
+
+        drop(cache);
+        assert!(
+            rebuilt.upgrade().is_none(),
+            "view worker drop releases its private fonts"
+        );
+    }
+
