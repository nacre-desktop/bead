 impl App {
+    pub(super) fn overlay_presentation(
+        &mut self,
+        data: &PresentationData,
+        event: &wp_presentation_feedback::Event,
+    ) -> bool {
+        let Some(overlay) = self.overlay.as_mut().filter(|overlay| {
+            overlay.epoch == data.source_epoch && overlay.layer.wl_surface() == &data.surface
+        }) else {
+            return false;
+        };
+        match event {
+            wp_presentation_feedback::Event::Presented {
+                tv_sec_hi,
+                tv_sec_lo,
+                tv_nsec,
+                refresh,
+                ..
+            } => {
+                let monotonic_ns = ((u64::from(*tv_sec_hi) << 32) | u64::from(*tv_sec_lo))
+                    * 1_000_000_000
+                    + u64::from(*tv_nsec);
+                if overlay.presented_update != Some(data.update) {
+                    if bead_core::profile::frame_trace() {
+                        println!(
+                            "WINDOW_PRESENTED monotonic_ns={monotonic_ns} epoch={} update={} generation={} refresh_ns={} kind=overlay",
+                            overlay.epoch, data.update, data.generation, refresh
+                        );
+                    }
+                    overlay.presented_update = Some(data.update);
+                }
+            }
+            wp_presentation_feedback::Event::Discarded => {
+                bead_core::vprintln!(
+                    "WINDOW_DISCARDED monotonic_ns={} epoch={} update={} generation={} kind=overlay",
+                    super::monotonic_ns(), overlay.epoch, data.update, data.generation
+                );
+            }
+            _ => {}
+        }
+        true
+    }
