   "expiry": "Group F QML deletion pass"
  },
  {
   "what": "Generated niri `shell.shortcut` binding (niri.rs) calls `qs ipc call nacreCompositor shortcut`; the shipped contract has no such binding",
   "expiry": "Group F QML deletion pass"
  },
  {
   "what": "QML-internal probes that read or restore QML view state with `qs ipc`: shell_supervisor.rs (only run by `nacre start`; the Bead drop-in replaces that ExecStart), session_watch.rs (CLI; the daemon observer uses ui.dispatch), display_recover.rs (queued only by the QML DisplayRecovery), lock_info.rs `lockWidgets state` (used for labels the lock config does not call live), niri_hover_probe.rs, tools/install.py validate_live, display-recover.py, desktop-actions.py lock widgets",
   "expiry": "N-E2 supervisor unit; deleted with QML in Group F"
  },
  {
   "what": "lock-info media buttons (`mpris previous|next|playPause`) go through ui.dispatch first and, when the provider refuses (Bead), to the daemon `player.*` methods on the active `dashboard.player` entity (B0084)",
   "expiry": "none: provider-neutral"
  }
 ],
