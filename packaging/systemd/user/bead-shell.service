[Unit]
Description=Bead development shell
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathIsDirectory=/usr/share/bead/shell
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/usr/share/bead
ExecStart=/usr/bin/nacre-shell --bar --bar-panel
Restart=on-failure
RestartSec=1
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
